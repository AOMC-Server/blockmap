{
	"name": "blockmap",
	"private": true,
	"workspaces": [
		"server",
		"web",
		"shared",
		"block-ui"
	],
	"scripts": {
		"dev": "bun --watch server/src/index.ts",
		"dev:web": "bun run --cwd web dev",
		"build": "bun run --cwd web build",
		"test": "bun test server web shared scripts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p server && tsc --noEmit -p shared && tsc --noEmit -p web && tsc --noEmit -p scripts",
		"backup": "bun scripts/backup.ts",
		"import-v1": "bun scripts/import-v1.ts",
		"import-xlsx": "bun scripts/import-xlsx.ts",
		"resize-tiles": "bun scripts/resize-tiles.ts",
		"db:generate": "bun run --cwd server db:generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.5",
		"typescript": "^7.0.2",
		"@e965/xlsx": "^0.20.3"
	}
}
